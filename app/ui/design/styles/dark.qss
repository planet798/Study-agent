/* ==========================================================================
   Study-Agent — Dark warm-neutral theme QSS template
   --------------------------------------------------------------------------
   - 只使用双花括号 placeholder（{ { name } } 语法）；颜色不得写死。
   - 由 ThemeManager.render_qss() 用 semantic token 渲染后注入 QApplication。
   - 保留 legacy selectors（PrimaryButton / SecondaryButton / TaskCard ...），
     现有页面与测试继续生效。
   - light.qss 必须与本文件保持相同的 placeholder 集合（有 parity 测试保证）。
   ========================================================================== */

QWidget {
    font-family: {{font_family}};
    font-size: {{font_size_body}};
    color: {{text_primary}};
}
QMainWindow, QDialog {
    background-color: {{background}};
}

/* ---- legacy 文本角色 ---- */
#AppTitle {
    font-size: 22px;
    font-weight: 600;
    color: {{text_primary}};
}
#AppDate {
    font-size: 13px;
    color: {{text_secondary}};
}
#SectionTitle {
    font-size: 17px;
    font-weight: 600;
    color: {{text_primary}};
    padding-top: 8px;
}
#EmptyHint {
    color: {{text_tertiary}};
    font-size: 15px;
    padding: 30px;
}

/* ---- legacy 任务卡片 ---- */
QFrame#TaskCard {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid {{border_subtle}};
    border-radius: 0px;
    margin: 0;
}
QFrame#TaskCard[done="true"],
QFrame#TaskCard[postponing="true"] {
    background-color: transparent;
    border-bottom-color: {{border_subtle}};
}
#TaskTitle {
    font-size: 15px;
    font-weight: 600;
    color: {{text_primary}};
}
#TaskDesc {
    color: {{text_secondary}};
    font-size: 13px;
}
#TaskMeta {
    color: {{text_secondary}};
    font-size: 12px;
}
#ReviewTag {
    color: {{accent}};
    font-size: 12px;
    font-weight: 600;
}
#TaskReason {
    color: {{warning}};
    font-size: 12px;
}
#PostponeWarning {
    color: {{warning}};
    font-size: 12px;
    font-weight: 600;
}
QFrame#TaskCard QLabel#SATag {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0;
    color: {{text_tertiary}};
    font-size: {{font_size_caption}};
}
QFrame#TaskCard QLabel#SATag[saTagVariant="accent"],
QFrame#TaskCard QLabel#SATag[saTagVariant="info"],
QFrame#TaskCard QLabel#SATag[saTagVariant="neutral"] {
    background: transparent;
    color: {{text_secondary}};
}
#DoneBadge {
    color: {{success}};
    font-weight: 600;
}

/* ---- 按钮 ---- */
QPushButton {
    background-color: {{surface_alt}};
    border: 1px solid {{border}};
    border-radius: {{radius_small}};
    padding: 6px 14px;
    color: {{text_primary}};
}
QPushButton:hover {
    background-color: {{surface_hover}};
}
QPushButton:pressed {
    background-color: {{surface_pressed}};
}
QPushButton:disabled {
    color: {{text_disabled}};
    border-color: {{border_subtle}};
}
QPushButton:focus,
QPushButton#PrimaryButton:focus,
QPushButton#SecondaryButton:focus,
QPushButton#DangerButton:focus,
QPushButton#PostponeButton:focus,
QPushButton[saVariant="subtle"]:focus {
    border: 1px solid {{focus}};
}
QPushButton#PrimaryButton {
    background-color: {{action_background}};
    border: 1px solid {{action_background}};
    color: {{action_text}};
    font-weight: 600;
}
QPushButton#PrimaryButton:hover {
    background-color: {{action_background_hover}};
    border-color: {{action_background_hover}};
}
QPushButton#PrimaryButton:pressed {
    background-color: {{action_background_pressed}};
    border-color: {{action_background_pressed}};
}
QPushButton#PrimaryButton:disabled {
    background-color: {{action_background_disabled}};
    border-color: {{action_background_disabled}};
    color: {{action_text_disabled}};
}
QPushButton#DangerButton {
    background-color: {{surface_alt}};
    border-color: {{danger}};
    color: {{danger}};
}
QPushButton#DangerButton:hover {
    background-color: {{danger_background}};
}
QPushButton#PostponeButton {
    border-color: {{warning}};
    color: {{warning}};
}
QPushButton#PostponeButton:hover {
    background-color: {{warning_background}};
}
QPushButton#SecondaryButton {
    background-color: {{surface_alt}};
    border: 1px solid {{border}};
    color: {{text_primary}};
    font-weight: 500;
}
QPushButton#SecondaryButton:hover {
    background-color: {{surface_hover}};
}
QPushButton#SecondaryButton:pressed {
    background-color: {{surface_pressed}};
}
QPushButton#SecondaryButton:disabled {
    color: {{text_disabled}};
    border-color: {{border}};
}

/* ---- 新 Design System 按钮变体 ---- */
QPushButton[saVariant="subtle"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: {{text_primary}};
    font-weight: normal;
}
QPushButton[saVariant="subtle"]:hover {
    background-color: {{surface_hover}};
}
QPushButton[saVariant="subtle"]:pressed {
    background-color: {{surface_pressed}};
}
QPushButton[saVariant="subtle"]:disabled {
    color: {{text_disabled}};
    background-color: transparent;
}
QPushButton[saButton="true"][saSize="small"] {
    padding: 3px 10px;
}
QPushButton[saButton="true"][saSize="medium"] {
    padding: 6px 14px;
}

/* ---- legacy 统计栏（历史保留） ---- */
QFrame#StatsBar {
    background-color: {{surface}};
    border: 1px solid {{border_subtle}};
    border-radius: {{radius_medium}};
}
#StatsTitle {
    font-weight: 600;
    color: {{text_primary}};
    font-size: 14px;
}
#StatsValue {
    font-weight: 600;
    color: {{accent}};
    font-size: 14px;
}

/* ---- 输入 ---- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: {{radius_small}};
    padding: 6px;
    color: {{text_primary}};
    selection-background-color: {{accent}};
    selection-color: {{text_on_accent}};
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid {{focus}};
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: {{text_disabled}};
    background-color: {{surface_alt}};
}
QLineEdit[saMono="true"], QPlainTextEdit[saMono="true"] {
    font-family: {{font_mono}};
}

/* ---- ComboBox ---- */
QComboBox {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: {{radius_small}};
    padding: 5px 8px;
    color: {{text_primary}};
    min-height: 20px;
}
QComboBox:hover {
    border-color: {{border_strong}};
}
QComboBox:focus {
    border: 1px solid {{focus}};
}
QComboBox:disabled {
    color: {{text_disabled}};
    background-color: {{surface_alt}};
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: {{surface}};
    border: 1px solid {{border}};
    selection-background-color: {{surface_selected}};
    selection-color: {{text_primary}};
    outline: none;
}

/* ---- CheckBox / RadioButton ---- */
QCheckBox, QRadioButton {
    color: {{text_primary}};
    spacing: 6px;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: {{text_disabled}};
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator {
    border: 1px solid {{border_strong}};
    border-radius: 3px;
    background-color: {{surface}};
}
QCheckBox::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
}
QRadioButton::indicator {
    border: 1px solid {{border_strong}};
    border-radius: 8px;
    background-color: {{surface}};
}
QRadioButton::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
}

/* ---- Tabs ---- */
QTabWidget::pane {
    border: 1px solid {{border_subtle}};
    background-color: {{surface}};
    border-radius: {{radius_small}};
}
QTabBar::tab {
    background-color: transparent;
    color: {{text_secondary}};
    padding: 7px 14px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: {{text_primary}};
}
QTabBar::tab:selected {
    color: {{accent}};
    border-bottom: 2px solid {{accent}};
}
QTabBar::tab:focus {
    color: {{accent}};
}

/* ---- List / Tree ---- */
QListWidget, QTreeWidget {
    background-color: {{surface}};
    border: 1px solid {{border_subtle}};
    border-radius: {{radius_small}};
    color: {{text_primary}};
    outline: none;
}
QListWidget::item, QTreeWidget::item {
    padding: 4px 6px;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: {{surface_hover}};
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: {{surface_selected}};
    color: {{text_primary}};
}

/* ---- 滚动 ---- */
QScrollArea {
    border: none;
    background: transparent;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background-color: {{border_strong}};
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background-color: {{text_tertiary}};
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background-color: {{border_strong}};
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---- Menu / Tooltip ---- */
QMenu {
    background-color: {{surface}};
    border: 1px solid {{border}};
    color: {{text_primary}};
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: {{radius_small}};
}
QMenu::item:selected {
    background-color: {{surface_selected}};
}
QMenu::separator {
    height: 1px;
    background: {{border_subtle}};
    margin: 4px 8px;
}
QToolTip {
    background-color: {{surface_alt}};
    color: {{text_primary}};
    border: 1px solid {{border}};
    padding: 4px 6px;
}

/* ---- StatusBar / ProgressBar ---- */
QStatusBar {
    background-color: {{surface_alt}};
    color: {{text_secondary}};
}
QStatusBar::item {
    border: none;
}
QProgressBar {
    background-color: {{surface_alt}};
    border: none;
    border-radius: {{radius_small}};
    text-align: center;
    color: {{text_primary}};
}
QProgressBar::chunk {
    background-color: {{accent}};
    border-radius: {{radius_small}};
}

/* ---- 语义 label（替代散布式 setStyleSheet("color:#e74c3c")） ---- */
QErrorMessage {
    color: {{danger}};
}
QLabel[role="danger"] {
    color: {{danger}};
}
QLabel[role="warning"] {
    color: {{warning}};
}
QLabel[role="success"] {
    color: {{success}};
}
QLabel[role="info"] {
    color: {{info}};
}
QLabel[role="body_secondary"] {
    color: {{text_secondary}};
}
QLabel[role="caption"] {
    color: {{text_secondary}};
    font-size: {{font_size_caption}};
}

/* ---- Design System 组件 ---- */
QFrame#SACard {
    background-color: {{surface}};
    border: 1px solid {{border_subtle}};
    border-radius: {{radius_medium}};
}
QFrame#SACard[saCardVariant="interactive"]:hover {
    background-color: {{surface_hover}};
    border-color: {{border}};
}
QFrame#SACard[saCardVariant="selected"] {
    border: 1px solid {{border_strong}};
    background-color: {{surface_selected}};
}
QLabel#SATag {
    border-radius: 999px;
    padding: 1px 8px;
    font-size: {{font_size_caption}};
}
QLabel#SATag[saTagVariant="neutral"] {
    background-color: {{surface_alt}};
    color: {{text_secondary}};
}
QLabel#SATag[saTagVariant="accent"] {
    background-color: {{surface_selected}};
    color: {{accent}};
}
QLabel#SATag[saTagVariant="success"] {
    background-color: {{success_background}};
    color: {{success}};
}
QLabel#SATag[saTagVariant="warning"] {
    background-color: {{warning_background}};
    color: {{warning}};
}
QLabel#SATag[saTagVariant="danger"] {
    background-color: {{danger_background}};
    color: {{danger}};
}
QLabel#SATag[saTagVariant="info"] {
    background-color: {{info_background}};
    color: {{info}};
}
QLabel#SAStatusBadge {
    border-radius: 999px;
    padding: 1px 8px;
    font-size: {{font_size_caption}};
    font-weight: 600;
}
QLabel#SAStatusBadge[saStatus="active"],
QLabel#SAStatusBadge[saStatus="completed"] {
    background-color: {{success_background}};
    color: {{success}};
}
QLabel#SAStatusBadge[saStatus="in_progress"] {
    background-color: {{info_background}};
    color: {{info}};
}
QLabel#SAStatusBadge[saStatus="planned"] {
    background-color: {{surface_alt}};
    color: {{text_secondary}};
}
QLabel#SAStatusBadge[saStatus="paused"],
QLabel#SAStatusBadge[saStatus="warning"] {
    background-color: {{warning_background}};
    color: {{warning}};
}
QLabel#SAStatusBadge[saStatus="archived"] {
    background-color: {{surface_alt}};
    color: {{text_disabled}};
}
QLabel#SASectionTitle {
    color: {{text_primary}};
    font-size: 17px;
    font-weight: 600;
}
QLabel#SASectionSubtitle {
    color: {{text_secondary}};
    font-size: {{font_size_caption}};
}
QLabel#SAEmptyTitle {
    color: {{text_primary}};
    font-size: 15px;
    font-weight: 600;
}
QLabel#SAEmptyDescription {
    color: {{text_secondary}};
    font-size: {{font_size_caption}};
}

/* ---- App Shell / Sidebar / PageHeader ---- */
QWidget#SANavigationSidebar {
    background-color: {{surface}};
    border-right: 1px solid {{border_subtle}};
}
QWidget#SAWorkspace {
    background-color: {{background}};
}
QLabel#SABrandTitle {
    font-size: 15px;
    font-weight: 600;
    color: {{text_primary}};
}
QLabel#SASessionsHeading {
    color: {{text_tertiary}};
    font-size: {{font_size_caption}};
    font-weight: 600;
}
QLabel#SASessionPinMarker {
    color: {{text_tertiary}};
    font-size: {{font_size_caption}};
}
QPushButton#SANavigationItem {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: {{radius_small}};
    padding: 8px 10px;
    text-align: left;
    color: {{text_secondary}};
    font-weight: normal;
}
QPushButton#SANavigationItem:hover {
    background-color: {{surface_hover}};
    color: {{text_primary}};
}
QPushButton#SANavigationItem:pressed {
    background-color: {{surface_pressed}};
}
QPushButton#SANavigationItem:checked {
    background-color: {{surface_selected}};
    border-color: transparent;
    color: {{text_primary}};
    font-weight: 600;
}
QPushButton#SANavigationItem:focus {
    border: 1px solid {{focus}};
}
QPushButton#SANavigationItem:disabled {
    color: {{text_disabled}};
    background-color: transparent;
}
QPushButton#SANavigationItem[collapsed="true"] {
    padding: 8px;
    text-align: center;
}
QFrame#SADivider {
    background-color: {{border_subtle}};
    border: none;
}
QWidget#SAPageHeader {
    background-color: {{background}};
}
QFrame#SAPageHeaderDivider {
    background-color: {{border_subtle}};
    border: none;
}
QLabel#SAPageTitle {
    font-size: 22px;
    font-weight: 600;
    color: {{text_primary}};
}
QLabel#SAPageSubtitle {
    font-size: 13px;
    color: {{text_secondary}};
}

/* ---- SAStatCard ---- */
QFrame#SAStatCard {
    background-color: {{surface}};
    border: 1px solid {{border_subtle}};
    border-radius: {{radius_medium}};
}
QFrame#SAStatCard[saStatStyle="compact"] {
    background: transparent;
    border: none;
    border-radius: 0px;
}
QLabel#SAStatValue {
    color: {{text_primary}};
}
QLabel#SAStatLabel {
    color: {{text_secondary}};
}
QLabel#SAStatHelper {
    color: {{text_tertiary}};
    font-size: {{font_size_caption}};
}
QFrame#SAStatCard[saStatStyle="compact"] QLabel#SAStatValue {
    font-size: 14px;
    font-weight: 600;
}
QFrame#SAStatCard[saStatStyle="compact"] QLabel#SAStatLabel {
    color: {{text_secondary}};
    font-size: {{font_size_caption}};
}

/* ---- SAProgressBar ---- */
QProgressBar#SAProgressBar {
    background-color: {{surface_alt}};
    border: none;
    border-radius: {{radius_small}};
}
QProgressBar#SAProgressBar::chunk {
    background-color: {{accent}};
    border-radius: {{radius_small}};
}
QLabel#SAProgressLabel {
    color: {{text_secondary}};
}
QLabel#SAProgressValue {
    color: {{text_primary}};
    font-weight: 600;
}

/* ---- SAInfoBanner ---- */
QFrame#SAInfoBanner {
    border-radius: {{radius_small}};
    border: 1px solid transparent;
    background-color: {{surface_alt}};
}
QFrame#SAInfoBanner[saBannerVariant="info"] {
    background-color: {{surface_alt}};
    border-color: transparent;
}
QFrame#SAInfoBanner[saBannerVariant="warning"] {
    background-color: {{warning_background}};
    border-color: transparent;
}
QFrame#SAInfoBanner[saBannerVariant="danger"] {
    background-color: {{danger_background}};
    border-color: transparent;
}
QFrame#SAInfoBanner[saBannerVariant="success"] {
    background-color: {{success_background}};
    border-color: transparent;
}
QLabel#SAInfoBannerTitle {
    color: {{text_primary}};
    font-weight: 600;
}
QLabel#SAInfoBannerDescription {
    color: {{text_secondary}};
    font-size: {{font_size_caption}};
}

/* ---- Route card helper labels ---- */
QLabel#SARouteKey {
    color: {{text_tertiary}};
    font-size: {{font_size_caption}};
}
QLabel#SAValueLabel {
    color: {{text_secondary}};
}
QLabel#SAValueStrong {
    color: {{text_primary}};
    font-weight: 600;
}

/* ---- Today scroll surface (theme-stable, semantic tokens only) ---- */
QScrollArea#SATodayScroll {
    background: transparent;
    border: none;
}
QScrollArea#SATodayScroll QWidget#SATodayViewport {
    background-color: {{background}};
}
QWidget#SATodayListContainer {
    background-color: {{background}};
}
QWidget#SACareerSection {
    background: transparent;
}
QScrollArea#SASessionsScroll,
QWidget#SASessionsBody,
QScrollArea#SASessionsScroll QWidget#qt_scrollarea_viewport {
    background-color: {{surface}};
    border: none;
}

/* ---- Agent Workspace conversation (UX-1) ---- */
QScrollArea#AgentConversationScroll {
    background: transparent;
    border: none;
}
QWidget#AgentMessageRow {
    background: transparent;
}
QFrame#AgentMessageBubble {
    border-radius: {{radius_medium}};
}
QFrame#AgentMessageBubble[role="assistant"] {
    background: transparent;
    border: none;
}
QFrame#AgentMessageBubble[role="user"] {
    background-color: {{surface_alt}};
    border: none;
}
QLabel#AgentMessageSpeaker {
    color: {{text_secondary}};
    font-size: {{font_size_caption}};
    font-weight: 400;
}
QTextBrowser#AgentUserMessageText {
    padding: 0;
    background: transparent;
    border: none;
    color: {{text_primary}};
}
QTextBrowser#AgentAssistantMarkdown {
    padding: 0;
    background: transparent;
    border: none;
    color: {{text_primary}};
}

/* ---- Agent Workspace shell (UX-2) ---- */
QLabel#AgentTaskDescription {
    color: {{text_secondary}};
}
QLabel#AgentErrorBanner {
    background-color: {{danger_background}};
    border: 1px solid {{danger}};
    border-radius: {{radius_medium}};
    color: {{danger}};
    padding: 10px 12px;
}
QLabel#AgentInteractionStatus {
    color: {{text_secondary}};
    font-size: {{font_size_caption}};
}
QFrame#AgentApprovalCard {
    background-color: {{surface}};
    border: 1px solid {{border_subtle}};
    border-radius: {{radius_medium}};
}
QLabel#AgentApprovalSectionTitle {
    color: {{text_primary}};
    font-size: {{font_size_body}};
    font-weight: 600;
}
QLabel#AgentApprovalSectionCaption {
    color: {{text_tertiary}};
    font-size: {{font_size_caption}};
}
QLabel#AgentApprovalActionTitle {
    color: {{text_primary}};
    font-weight: 600;
}
QLabel#AgentApprovalDescription {
    color: {{text_secondary}};
}
QLabel#AgentApprovalNoteCaption {
    color: {{text_tertiary}};
    font-size: {{font_size_caption}};
}
QLabel#AgentApprovalNoteValue,
QLabel#AgentApprovalNotePreview {
    color: {{text_primary}};
    background-color: {{surface_alt}};
    border-radius: {{radius_small}};
    padding: 6px 8px;
}
QFrame#AgentComposer {
    background-color: {{surface}};
    border: 1px solid {{border_subtle}};
    border-radius: {{radius_medium}};
}
QPlainTextEdit#AgentMessageInput {
    background: transparent;
    border: none;
    color: {{text_primary}};
}
QLabel#AgentComposerHint,
QLabel#AgentComposerCounter {
    color: {{text_tertiary}};
    font-size: {{font_size_caption}};
}
QLabel#AgentInputWarning {
    color: {{danger}};
    font-size: {{font_size_caption}};
}

/* UX-3 latest / unread conversation affordance */
QPushButton#AgentLatestButton {
    background-color: {{surface}};
    color: {{accent}};
    border: 1px solid {{border}};
    border-radius: {{radius_small}};
    padding: 4px 10px;
}
QPushButton#AgentLatestButton:hover {
    background-color: {{surface_hover}};
}

/* Object names retain UI/test identity; primary variant stays Agent-local. */
QPushButton#AgentSendButton[saVariant="primary"],
QPushButton#AgentApprovalApprove[saVariant="primary"] {
    background-color: {{action_background}};
    border: 1px solid {{action_background}};
    color: {{action_text}};
    font-weight: 600;
}
QPushButton#AgentSendButton[saVariant="primary"]:hover,
QPushButton#AgentApprovalApprove[saVariant="primary"]:hover {
    background-color: {{action_background_hover}};
    border-color: {{action_background_hover}};
}
QPushButton#AgentSendButton[saVariant="primary"]:pressed,
QPushButton#AgentApprovalApprove[saVariant="primary"]:pressed {
    background-color: {{action_background_pressed}};
    border-color: {{action_background_pressed}};
}
QPushButton#AgentSendButton[saVariant="primary"]:disabled,
QPushButton#AgentApprovalApprove[saVariant="primary"]:disabled {
    background-color: {{action_background_disabled}};
    border-color: {{action_background_disabled}};
    color: {{action_text_disabled}};
}
QPushButton#AgentSendButton[saVariant="primary"]:focus,
QPushButton#AgentApprovalApprove[saVariant="primary"]:focus {
    border-color: {{focus}};
}
QLabel#AgentWorkspaceBadge {
    color: {{text_secondary}};
    font-size: {{font_size_caption}};
}
QLabel#AgentWorkspaceBadge[unavailable="true"] {
    color: {{warning}};
}

/* ---- Agent embedded source/document panels (local only) ---- */
QFrame#AgentCodePanel {
    background: {{surface_alt}};
    border: 1px solid {{border_subtle}};
    border-radius: 8px;
}
QLabel#AgentCodeLanguage {
    color: {{text_secondary}};
    background: transparent;
    font-size: {{font_size_caption}};
}
QTextBrowser#AgentCodeSource {
    background: transparent;
    border: none;
    padding: 0;
    color: {{text_primary}};
}
QPushButton#AgentCodeCopy, QPushButton#AgentCodeTab, QPushButton#AgentCodeExpand {
    background: transparent;
    color: {{text_secondary}};
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 20px;
}
QPushButton#AgentCodeCopy:hover, QPushButton#AgentCodeTab:hover, QPushButton#AgentCodeExpand:hover {
    background: {{surface_hover}};
    color: {{text_primary}};
}
QPushButton#AgentCodeTab:checked {
    background: {{surface_selected}};
    color: {{text_primary}};
}
QPushButton#AgentCodeCopy:focus, QPushButton#AgentCodeTab:focus, QPushButton#AgentCodeExpand:focus {
    border: 1px solid {{focus}};
}

/* Learning Routes: lightweight rows, scoped to this surface. */
QFrame#RouteOverviewRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid {{border_subtle}};
}
QFrame#RouteOverviewRow:hover {
    background-color: {{surface_hover}};
}
QFrame#RouteGroupHeading {
    background-color: transparent;
    border: none;
}
QLabel#RouteCurrentTopic {
    color: {{text_primary}};
    font-size: {{font_size_body}};
}

QFrame#RouteDetailSection, QFrame#RouteTopicRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid {{border_subtle}};
}

/* Practice workspace: scoped lightweight project rows. */
QFrame#PracticeOverviewRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid {{border_subtle}};
}
QFrame#PracticeOverviewRow:hover {
    background-color: {{surface_hover}};
}

QFrame#PracticeDetailSection, QFrame#PracticeMilestoneRow, QFrame#PracticeOutputRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid {{border_subtle}};
}

/* Settings/forms feedback uses semantic colors in both themes. */
QLabel#SettingsFeedback { color: {{text_secondary}}; }
QLabel#SettingsFeedback[feedbackState="success"] { color: {{success}}; }
QLabel#SettingsFeedback[feedbackState="error"] { color: {{danger}}; }

QScrollArea#FormDialogScroll, QWidget#FormDialogBody {
    background-color: transparent;
    border: none;
}
